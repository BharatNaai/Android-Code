<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 
      We can leave this empty or just inherit, because attributes 
      are now pointing to semantic colors in values-night/colors.xml.
      However, for specific overrides (like windowLightStatusBar becoming false in night mode), we do it here.
    -->
    <style name="Base.Theme.Bharatnaai" parent="Theme.Material3.DayNight.NoActionBar">
         <!-- In Dark Mode, we generally want white status bar icons (so lightStatusBar = false) -->
         <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>